<options>
<qmmm>
	<print_regions_pdb>false</print_regions_pdb>
	<map_file>system.xml</map_file>
	<job_file>qmmm_ewald.jobs</job_file>
	<regions>
		<qmregion>
			<id>0</id>
			<segments>jobfile</segments>
			<state>jobfile</state>
			<dftpackage>
				<basisset>3-21G</basisset>
				<auxbasisset>aux-def2-svp</auxbasisset>
				<functional>XC_GGA_X_PBE XC_GGA_C_PBE</functional>
			</dftpackage>
			<gwbse>
				<gw>
					<mode>G0W0</mode>
				</gw>
			</gwbse>
			<statetracker>
				<oscillatorstrength>0.0001</oscillatorstrength>
			</statetracker>
			<relaxed_density>true</relaxed_density>
			<compute_forces>true</compute_forces>
		</qmregion>
		<ewaldregion>
			<id>1</id>
			<checkpoint>ewaldbackground.hdf5</checkpoint>
		</ewaldregion>
	</regions>
</qmmm>
</options>

include(CMakeFindDependencyMacro)
if(@OpenMP_FOUND@)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../VOTCA_TOOLS/HomebrewLibomp.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/../VOTCA_TOOLS/HomebrewLibomp.cmake")
  endif()
  find_dependency(OpenMP 4.5)
endif()
find_dependency(HDF5 REQUIRED COMPONENTS CXX)
find_dependency(Boost 1.71.0 REQUIRED COMPONENTS program_options timer)
find_dependency(Eigen3 3.3.0 REQUIRED NO_MODULE)
find_dependency(VOTCA_CSG REQUIRED NO_MODULE)
find_dependency(VOTCA_TOOLS REQUIRED NO_MODULE)
include("${CMAKE_CURRENT_LIST_DIR}/VOTCA_XTP_Targets.cmake")

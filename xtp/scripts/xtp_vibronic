import argparse
import sys

VERSION = '@PROJECT_VERSION@ #VOTCA_GIT_ID#'
# the interpreter VOTCA installed pyxtp for (set at configure time)
PYXTP_PYTHON = '@Python_EXECUTABLE@'
PROGTITLE = 'THE VOTCA::XTP vibronic line shapes'
PROGDESCR = ('Vibronic line shapes from a finite-difference Hessian of '
             'analytic xtp DFT forces and the gradient of an energy gap '
             '(BSE excitation, QP level): Huang-Rhys factors, thermal '
             'Franck-Condon line shapes and ensemble spectra. Subcommands: '
             'hessian (run or continue the displaced force jobs; several '
             'processes or array-job parts can share a workdir), status, '
             'modes (collect the Hessian, save modes.npz), lineshape. '
             'Needs pyxtp.')
VOTCAHEADER = f"""
==================================================
========   VOTCA (http://www.votca.org)   ========
==================================================

{PROGTITLE}

please read and cite: @PROJECT_CITATION@
and submit bugs to @PROJECT_CONTACT@
xtp_vibronic, version {VERSION}

"""


class XtpHelpFormatter(argparse.HelpFormatter):
    def _format_usage(self, usage, action, group, prefix):
        return VOTCAHEADER


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="xtp_vibronic",
        formatter_class=lambda prog: XtpHelpFormatter(
            prog, max_help_position=70),
        description=PROGDESCR)
    sub = p.add_subparsers(dest="command", required=True)

    h = sub.add_parser("hessian", help="run the displaced force jobs")
    h.add_argument("-x", "--xyz", help="reference geometry (minimum); "
                   "not needed to continue an existing workdir")
    h.add_argument("-w", "--workdir", default="hessian")
    h.add_argument("-o", "--options", help="dftgwbse options file "
                   "(<options><dftgwbse>...</dftgwbse></options>)")
    h.add_argument("--set", action="append", metavar="KEY=VALUE",
                   help="pyxtp option, e.g. dftpackage.functional=PBE0 "
                   "(repeatable)")
    h.add_argument("-t", "--threads", type=int, default=1)
    h.add_argument("--step", type=float, default=0.005,
                   help="displacement in Angstrom")
    h.add_argument("--scheme", default="central",
                   choices=["central", "forward"])
    h.add_argument("--atoms", help="displace only these atoms "
                   "(comma separated, 0-based): partial Hessian")
    h.add_argument("--part", type=int, default=0,
                   help="this process computes jobs part, part+nparts, ...")
    h.add_argument("--nparts", type=int, default=1)
    h.add_argument("--no-warm-start", action="store_true",
                   help="do not start displaced SCFs from the reference MOs")

    s = sub.add_parser("status", help="progress of a workdir")
    s.add_argument("-w", "--workdir", default="hessian")
    s.add_argument("--clear-locks", action="store_true",
                   help="remove locks of unfinished jobs (after a crash)")

    m = sub.add_parser("modes", help="collect the Hessian and save the modes")
    m.add_argument("-w", "--workdir", default="hessian")
    m.add_argument("-m", "--modes", default="modes.npz", help="output file")

    ls = sub.add_parser("lineshape", help="couplings and line shape")
    src = ls.add_mutually_exclusive_group(required=True)
    src.add_argument("-m", "--modes", help="modes.npz from 'modes'")
    src.add_argument("--orca-hess", help="ORCA .hess file (needs --xyz)")
    ls.add_argument("-x", "--xyz", help="geometry for --orca-hess")
    ls.add_argument("-g", "--gradient", required=True,
                    help="gradient of the excitation energy or QP level: .orb "
                    "with excited_state_forces, .engrad, .npy or text "
                    "(N x 3, eV/Angstrom); its sign does not matter")
    ls.add_argument("-T", "--temperature", type=float, default=300.0)
    ls.add_argument("--lambda-classical", type=float, default=0.0,
                    help="classical (outer-sphere) reorganization, eV")
    ls.add_argument("--sigma", type=float, default=0.0,
                    help="Gaussian broadening (standard deviation), eV")
    ls.add_argument("--gamma", type=float, default=0.0,
                    help="Lorentzian broadening (half width), eV")
    ls.add_argument("--min-wavenumber", type=float, default=0.0,
                    help="leave out modes below this (cm^-1)")
    ls.add_argument("--classical-below", type=float,
                    help="treat modes below this (cm^-1) classically")
    ls.add_argument("-p", "--process", required=True,
                    choices=["absorption", "emission", "electron-addition",
                             "electron-removal", "ionization",
                             "electron-affinity"],
                    help="sets the energy axis of the spectrum and of "
                    "--sites: photon energy (absorption, emission), QP "
                    "level of the added/removed electron (electron-addition"
                    ", e.g. LUMO in inverse photoemission; electron-removal"
                    ", e.g. HOMO in photoemission), or ionization energy / "
                    "electron affinity (positive)")
    ls.add_argument("--step", type=float, default=1e-3,
                    help="energy step, eV")
    ls.add_argument("--sites", help="text file with vertical energies "
                    "(ensemble spectrum)")
    ls.add_argument("--column", type=int, default=0,
                    help="column of the vertical energies (0-based)")
    ls.add_argument("--where", action="append",
                    help="select rows, e.g. '1>4.0' (column 1 above 4.0)")
    ls.add_argument("--weight-column", type=int,
                    help="column with a weight per site")
    ls.add_argument("-o", "--output", default="lineshape.dat")
    ls.add_argument("--couplings", help="write the per-mode couplings here")
    return p


def main():
    args = build_parser().parse_args()
    print(VOTCAHEADER)
    try:
        from pyxtp.vibronic.cli import run
    except ImportError as err:
        sys.exit(f"xtp_vibronic needs pyxtp, which could not be imported "
                 f"with {sys.executable}: {err}\n"
                 f"VOTCA installs pyxtp for {PYXTP_PYTHON} (into its user "
                 "site-packages, or CMAKE_INSTALL_PYTHON_LIBDIR if set). Run "
                 "the script with that interpreter, or add the install "
                 "directory to PYTHONPATH.")
    run(args)


if __name__ == "__main__":
    main()
